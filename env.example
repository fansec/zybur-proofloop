# The names Zybur Proofloop reads, with what each is for. Names only: set the values in your environment,
# or in a credentials file outside the repository (ZYBUR_CREDS_FILE). docs/run.md has the detail.

# The lab registry: the only hosts Zybur Proofloop will attack (lab-hosts.example.json is the template).
LAB_HOSTS_FILE=
# The workstation target. WIN_HOST defaults to the registry's workstation address.
WIN_HOST=
WIN_USER=
WIN_PASS=
# The domain controller target, for use-cases with target: domain_controller.
DC_HOST=
DC_USER=
DC_PASS=
DC_DOMAIN=
DC_FQDN=
# The address the attacking machine uses on the lab network (network executors).
ATTACKER_IP=
# The source-address pool the network executors rotate through, and the addresses never to use.
DEDUP_SUBNET=
DEDUP_GATEWAY=
DEDUP_DENYLIST=
# CALDERA, for the caldera_command executor only.
CALDERA_SERVER=
CALDERA_API_KEY=
CALDERA_GROUP=
CALDERA_PLANNER=
# The SIEM: elastic (default) or recorded (with SIEM_RECORDED_DIR).
SIEM=
SIEM_RECORDED_DIR=
ES_URL=
ES_API_KEY=
# A folder holding .env.shared with ELASTIC_VALIDATION_URL and ELASTIC_VALIDATION_API_KEY, instead of ES_*.
ZYBUR_ENV_ROOT=
# A KEY=VALUE credentials file for the lab values above.
ZYBUR_CREDS_FILE=
# Where a run reads and writes. Defaults: ../rules_export.ndjson, state/ledger.jsonl, ../results.
RULES_EXPORT=
LEDGER_FILE=
RESULTS_DIR=
# Seconds between two detonations on one host (default 10; 0 disables the wait).
ZYBUR_DETONATION_GAP_S=
# Seconds an alert of a use-case's own target rule, one no later detonation targets, may land past the window's upper bound
# and still count (default 5, the clock-skew tolerance; a very large value switches the bound off). docs/method.md has the detail.
ZYBUR_UNCONTESTED_GRACE_S=
